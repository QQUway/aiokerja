# Database
DATABASE_URL=postgres://user:password@postgres:5432/workassistant

# LLM
# openai:            LLM_BASE_URL unset, LLM_MODEL=gpt-4o-mini
# openai_compatible:  Gemini example below (generativelanguage.googleapis.com
#                      exposes an OpenAI-compatible endpoint)
LLM_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash

# Embeddings (Gemini: gemini-embedding-001, max 2000 dims for pgvector HNSW)
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# RAG tuning
RAG_CHUNK_SIZE_TOKENS=512
RAG_CHUNK_OVERLAP_TOKENS=64
RAG_RETRIEVAL_TOP_K=6

# App
APP_URL=http://localhost:5173
BACKEND_PORT=8080
LOG_LEVEL=info